{
  "name": "percentage-clock",
  "version": "1.0.2",
  "description": "A percentage clock desktop application.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.electron.percentage-clock",
    "productName": "Percentage Clock",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "meohagi",
      "repo": "percentclock"
    }
  },
  "repository": "github:meohagi/percentclock",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/meohagi/percentclock/issues"
  },
  "homepage": "https://github.com/meohagi/percentclock#readme",
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
